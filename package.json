{
  "name": "iobroker.ring",
  "version": "7.0.0",
  "description": "Ring",
  "author": "Thiemo Hoffmann <thiemo.hoffmann@web.de>",
  "contributors": [
    "Thorsten Stueben <thorsten@stueben.de>",
    "Thiemo Hoffmann <thiemo.hoffmann@web.de>",
    "iobroker-community-adapters <iobroker-community-adapters@gmx.de>"
  ],
  "homepage": "https://github.com/iobroker-community-adapters/ioBroker.ring",
  "license": "MIT",
  "keywords": [
    "ring",
    "ioBroker",
    "template",
    "Smart Home",
    "home automation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iobroker-community-adapters/ioBroker.ring"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-core": "^3.4.3",
    "ffmpeg-static": "^5.3.0",
    "node-schedule": "^2.1.1",
    "ring-client-api": "^14.3.0",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "strftime": "^0.10.3",
    "suncalc": "^2.0.2"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/build-tools": "^3.0.3",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@iobroker/types": "^7.2.2",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.1",
    "@types/node-schedule": "^2.1.8",
    "@types/strftime": "^0.9.8",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "build:backend": "tsc -p tsconfig.build.json",
    "build:tab": "tsx tasks.ts",
    "build": "npm run build:backend && npm run build:tab",
    "0-clean": "tsx tasks.ts --0-clean",
    "1-npm": "tsx tasks.ts --1-npm",
    "2-build": "tsx tasks.ts --2-build",
    "3-copy": "tsx tasks.ts --3-copy",
    "4-patch": "tsx tasks.ts --4-patch",
    "watch": "tsc -p tsconfig.build.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:tab": "cd src-tab && tsc --noEmit",
    "check:tasks": "tsc -p tsconfig.tasks.json",
    "lint": "eslint -c eslint.config.mjs",
    "lint:tab": "cd src-tab && eslint -c eslint.config.mjs",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:package",
    "translate": "translate-adapter -b admin/i18n/en.json",
    "release": "release-script --noPush -y",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "npx npm-check-updates --upgrade && cd src-tab && npx npm-check-updates --upgrade"
  },
  "bugs": {
    "url": "https://github.com/iobroker-community-adapters/ioBroker.ring/issues"
  },
  "readmeFilename": "README.md"
}
